+	<div class="container mt-5">
+		<div class="d-flex justify-content-between align-items-center">
+			<h1 class="mb-0">TODO Calendar</h1>
+
+			<!-- 全未完了リセット -->
+			<form th:action="@{/reset-all}" method="post" onsubmit="return confirm('すべてのタスクを未完了に戻します。本当によろしいですか？');">
+
+				<button type="submit" class="btn btn-outline-warning btn-sm">
+					<i class="bi bi-arrow-counterclockwise"></i>
+					全リセット
+				</button>
+			</form>
+		</div>
+
+
+		<form th:action="@{/}" method="get" class="mt-3">
+			<div class="input-group">
+
+				<!-- 検索入力 -->
+				<input type="text" name="q" class="form-control" placeholder="タスクを検索" th:value="${q}">
+
+				<!-- 検索 -->
+				<button class="btn btn-outline-secondary" type="submit" title="検索">
+					<i class="bi bi-search"></i>
+				</button>
+
+				<!-- クリア -->
+				<a th:href="@{/}" class="btn btn-outline-secondary" title="検索条件をクリア">
+					<i class="bi bi-x-lg"></i>
+				</a>
+
+			</div>
+		</form>
+
+
+
+
+		<!-- タスク追加フォーム -->
+		<form th:action="@{/add}" method="post" th:object="${newTask}" class="d-flex mt-4">
+			<!-- タスクのタイトルを入力するフィールド -->
+			<input type="text" name="title" th:field="*{title}" class="form-control me-2" placeholder="New Task"
+				required>
+			<select th:field="*{priority}" class="form-select" style="max-width: 140px;">
+				<option th:each="p : ${priorities}" th:value="${p}" th:text="${p}">
+				</option>
+			</select>
+			<div class="col-md-4">
+				<input type="date" th:field="*{dueDate}" class="form-control">
+			</div>
+			<!-- タスクを追加するための送信ボタン -->
+			<button type="submit" class="btn btn-primary">Add</button>
+		</form>
+
+		<!-- タスク一覧表示 -->
+		<ul class="list-group mt-4">
+			<!-- タスクを繰り返し表示する -->
+			<li th:each="task : ${tasks}" class="list-group-item d-flex justify-content-between align-items-center">
+
+				<!-- 左側：タスク情報 -->
+				<div>
+					<!-- タイトル（完了なら打ち消し線） -->
+					<span th:text="${task.title}"
+						th:style="${task.completed} ? 'text-decoration: line-through; opacity:0.6;' : ''">
+					</span>
+
+					<!-- 優先度 -->
+					<span class="badge text-bg-secondary" th:if="${task.priority != null}" th:text="${task.priority}">
+					</span>
+
+					<!-- 期限 -->
+					<small class="text-muted ms-2" th:if="${task.dueDate != null}">
+						（期限：<span th:text="${task.dueDate}"></span>）
+					</small>
+				</div>
+
+				<!-- 右側：操作ボタン -->
+				<div class="d-flex gap-2">
+
+					<!-- 完了 / 戻す ボタン -->
+					<form th:action="@{/complete/{id}(id=${task.id})}" method="post" class="m-0">
+
+						<button type="submit" class="btn btn-sm"
+							th:classappend="${task.completed} ? ' btn-outline-secondary' : ' btn-success'"
+							th:text="${task.completed} ? '戻す' : '完了'">
+							完了
+						</button>
+					</form>
+
+					<!-- 削除 -->
+					<a th:href="@{/delete/{id}(id=${task.id})}" class="btn btn-danger btn-sm">
+						Delete
+					</a>
+
+				</div>
+			</li>
+
+
+		</ul>
+	</div>
+
+	<!-- Bootstrap JavaScriptの読み込み -->
+	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
+	<script>
+		// 17:00に未完了タスクがあればデスクトップ通知を出す
+		async function notifyIfTodayTasksIncomplete() {
+			try {
+				const res = await fetch('/api/tasks/today/incomplete');
+				if (!res.ok) return;
+
+				const tasks = await res.json();
+				if (!tasks || tasks.length === 0) return;
+
+				// 通知権限チェック
+				if (!("Notification" in window)) return;
+
+				if (Notification.permission === "default") {
+					await Notification.requestPermission();
+				}
+				if (Notification.permission !== "granted") return;
+
+				const titles = tasks.slice(0, 3).map(t => "・" + t.title).join("\n");
+				const more = tasks.length > 3 ? `\n…他 ${tasks.length - 3}件` : "";
+
+				new Notification("17:00 リマインド", {
+					body: `今日のタスクがまだ残ってるよ（${tasks.length}件）\n${titles}${more}`
+				});
+
+			} catch (e) {
+				console.error(e);
+			}
+		}
+
+		// 今日の17:00までの待ち時間を計算して、到達したら実行
+		function schedule17Notification() {
+			const now = new Date();
+			const target = new Date();
+			target.setHours(17, 0, 0, 0);
+
+			// すでに17:00過ぎてたら今日は何もしない（必要なら「即チェック」に変えられる）
+			if (now >= target) return;
+
+			const ms = target.getTime() - now.getTime();
+			setTimeout(() => {
+				notifyIfTodayTasksIncomplete();
+			}, ms);
+		}
+
+		document.addEventListener("DOMContentLoaded", () => {
+			schedule17Notification();
+		});
+	</script>
+
 </body>
 
